{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "adversarial-review:test",
      "type": "shell",
      "command": "python3 -m unittest discover -s tools/adversarial_reviewer -p 'test_*.py'",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "adversarial-review:debug",
      "type": "shell",
      "command": "python3 tools/adversarial_reviewer/adversarial_review.py --base origin/main --target 'local-debug' --mock --json",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "adversarial-review:run",
      "type": "shell",
      "command": "python3 tools/adversarial_reviewer/fetch_model.py && python3 tools/adversarial_reviewer/adversarial_review.py --base origin/main --target 'local-run' --fail-on request-changes",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "adversarial-review:profile",
      "type": "shell",
      "command": "python3 -m cProfile -s tottime tools/adversarial_reviewer/adversarial_review.py --base origin/main --mock",
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
